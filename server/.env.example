# =====================================================================
# 听书服务 · 配置模板（可以提交到 git，不含任何真实密钥）
# 使用：复制为 .env 后填写。新增配置项时同步更新本文件，并写明用途和单位。
# 生成随机密钥：openssl rand -hex 32
# =====================================================================

# ---------- 运行环境 ----------
APP_ENV=production
LOG_LEVEL=INFO

# ---------- API 服务 ----------
# 只监听本机，由 Tailscale 提供 HTTPS 后转发进来，不直接监听 tailnet 或公网地址
API_HOST=127.0.0.1
API_PORT=8000
# 客户端访问地址（MagicDNS 域名，待定）
PUBLIC_BASE_URL=https://example.tailnet.ts.net

# ---------- 数据库与队列（docker compose 也读取这几项） ----------
POSTGRES_USER=audiobook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=audiobook
DATABASE_URL=postgresql+psycopg://audiobook:change-me@127.0.0.1:5432/audiobook
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------- 鉴权 ----------
# 用于对 API Key 做 HMAC 哈希；更换后所有已签发的 Key 失效
API_KEY_HASH_SECRET=change-me
# 用于签名音频下载链接；更换后已发出的链接立即失效
SIGNED_URL_SECRET=change-me
SIGNED_URL_TTL_SECONDS=3600
AUTH_FAIL_LIMIT_PER_MINUTE=10

# ---------- 存储（服务器本地磁盘，不在仓库内） ----------
BOOK_STORAGE_DIR=/srv/audiobook/books
AUDIO_STORAGE_DIR=/srv/audiobook/audio
AUDIO_TMP_DIR=/srv/audiobook/tmp
# 1TB = 1,000,000,000,000 字节
AUDIO_STORAGE_MAX_BYTES=1000000000000
STORAGE_CLEANUP_HIGH_WATERMARK=0.90
STORAGE_CLEANUP_LOW_WATERMARK=0.80

# ---------- 缓存窗口 ----------
CACHE_WINDOW_BEFORE=10
CACHE_WINDOW_AFTER=40
# 512MB = 512 × 1024 × 1024 字节
CACHE_WINDOW_MAX_BYTES=536870912
# 尚无实际数据时每字字节数的估算值：按 64kbps、每秒约 4 字估算（待定，随码率调整）
DEFAULT_BYTES_PER_CHAR=2000

# ---------- 音频编码（待定） ----------
AUDIO_CODEC=aac
AUDIO_BITRATE=64k
AUDIO_SAMPLE_RATE=24000

# ---------- 每日额度 ----------
DAILY_CHAR_LIMIT=<待填：每个账户每日字数上限>
DAILY_RESET_TIME=00:00
DAILY_RESET_TIMEZONE=<待填：例如 Asia/Shanghai>
QUOTA_RESERVATION_TIMEOUT_MINUTES=60

# ---------- 重试上限 ----------
LLM_VALIDATION_MAX_RETRIES=2
TTS_SEGMENT_MAX_RETRIES=3
CHAPTER_AUTO_RETRY=1

# ---------- 音色分配 ----------
EXCLUSIVE_VOICE_TOP_N=<待填：独占音色的重要角色数量>

# ---------- LLM（供应商待定） ----------
LLM_PROVIDER=<待填>
LLM_MODEL=<待填>
LLM_API_KEY=

# ---------- TTS（方案待定） ----------
TTS_PROVIDER=<待填：local 或云服务名称>
# 以下几项仅在 TTS_PROVIDER=local 时使用
TTS_MODEL_DIR=/srv/audiobook/models
TTS_DEVICE=cuda:0
# Titan V 不支持 bf16，自部署模型一律用 fp16
TTS_DTYPE=float16
CUDA_VISIBLE_DEVICES=0
# 12GB 显存只放一个 TTS 模型实例，GPU 队列并发固定为 1
TTS_WORKER_CONCURRENCY=1
# 仅在使用云端 TTS 时填写
TTS_API_KEY=
